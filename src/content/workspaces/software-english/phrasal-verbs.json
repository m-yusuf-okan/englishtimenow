{
  "$schema": "../../schema.json",
  "slug": "phrasal-verbs",
  "title": "Phrasal Verbs",
  "description": "Yazılım ekiplerinin günlük iletişiminde en sık geçen öbek fiiller ve aldıkları edatlar.",
  "theme": "emerald",
  "vocab": [
    {
      "kind": "vocab",
      "id": "phv-set-up",
      "level": "A2",
      "term": "set up",
      "ipa": "/ˌset ˈʌp/",
      "translation": "kurmak, ayarlamak",
      "example": {
        "en": "I need to set up the project before the meeting.",
        "tr": "Toplantıdan önce projeyi kurmam gerekiyor."
      },
      "collocations": ["set up + a project", "set up + an account", "set up + a server"]
    },
    {
      "kind": "vocab",
      "id": "phv-figure-out",
      "level": "A2",
      "term": "figure out",
      "ipa": "/ˌfɪɡər ˈaʊt/",
      "translation": "çözmek, anlamak",
      "example": {
        "en": "We could not figure out why the test was failing.",
        "tr": "Testin neden başarısız olduğunu çözemedik."
      },
      "collocations": ["figure out + a problem", "figure out + how to ..."]
    },
    {
      "kind": "vocab",
      "id": "phv-depend-on",
      "level": "A2",
      "term": "depend on",
      "ipa": "/dɪˈpend ɒn/",
      "translation": "bağlı olmak, dayanmak",
      "example": {
        "en": "This feature depends on the new database.",
        "tr": "Bu özellik yeni veritabanına bağlı."
      },
      "collocations": ["depend + on", "it depends on + noun"]
    },
    {
      "kind": "vocab",
      "id": "phv-look-into",
      "level": "A2",
      "term": "look into",
      "ipa": "/ˌlʊk ˈɪntuː/",
      "translation": "araştırmak, incelemek",
      "example": {
        "en": "Can you look into this bug today?",
        "tr": "Bu hatayı bugün inceleyebilir misin?"
      },
      "collocations": ["look into + an issue", "look into + a report"]
    },
    {
      "kind": "vocab",
      "id": "phv-run-into",
      "level": "A2",
      "term": "run into",
      "ipa": "/ˌrʌn ˈɪntuː/",
      "translation": "karşılaşmak, denk gelmek",
      "example": {
        "en": "We ran into a problem after the update.",
        "tr": "Güncellemeden sonra bir sorunla karşılaştık."
      },
      "collocations": ["run into + a problem", "run into + trouble"]
    },
    {
      "kind": "vocab",
      "id": "phv-back-up",
      "level": "A2",
      "term": "back up",
      "ipa": "/ˌbæk ˈʌp/",
      "translation": "yedeklemek",
      "example": {
        "en": "Please back up your files before you start.",
        "tr": "Başlamadan önce lütfen dosyalarını yedekle."
      },
      "collocations": ["back up + data", "back up + a database"]
    },
    {
      "kind": "vocab",
      "id": "phv-shut-down",
      "level": "A1",
      "term": "shut down",
      "ipa": "/ˌʃʌt ˈdaʊn/",
      "translation": "kapatmak",
      "example": {
        "en": "Shut down the server before the update.",
        "tr": "Güncellemeden önce sunucuyu kapat."
      },
      "collocations": ["shut down + a server", "shut down + a computer"]
    },
    {
      "kind": "vocab",
      "id": "phv-log-in",
      "level": "A1",
      "term": "log in",
      "ipa": "/ˌlɒɡ ˈɪn/",
      "translation": "giriş yapmak",
      "example": {
        "en": "You must log in to see your notes.",
        "tr": "Notlarını görmek için giriş yapmalısın."
      },
      "collocations": ["log in + to a system", "log in + with an email"]
    },
    {
      "kind": "vocab",
      "id": "phv-carry-out",
      "level": "B1",
      "term": "carry out",
      "ipa": "/ˌkæri ˈaʊt/",
      "translation": "yürütmek, gerçekleştirmek",
      "example": {
        "en": "The team carried out a small test yesterday.",
        "tr": "Ekip dün küçük bir test gerçekleştirdi."
      },
      "collocations": ["carry out + a test", "carry out + research", "carry out + a plan"]
    },
    {
      "kind": "vocab",
      "id": "phv-break-down",
      "level": "B1",
      "term": "break down",
      "ipa": "/ˌbreɪk ˈdaʊn/",
      "translation": "bozulmak; parçalara ayırmak",
      "example": {
        "en": "Let's break down this task into smaller steps.",
        "tr": "Bu görevi daha küçük adımlara ayıralım."
      },
      "collocations": ["break down + a task", "break down + into steps"]
    },
    {
      "kind": "vocab",
      "id": "phv-roll-out",
      "level": "B1",
      "term": "roll out",
      "ipa": "/ˌrəʊl ˈaʊt/",
      "translation": "yayına almak, sunmak",
      "example": {
        "en": "We will roll out the new design next week.",
        "tr": "Yeni tasarımı gelecek hafta yayına alacağız."
      },
      "collocations": ["roll out + a feature", "roll out + an update"]
    },
    {
      "kind": "vocab",
      "id": "phv-point-out",
      "level": "B1",
      "term": "point out",
      "ipa": "/ˌpɔɪnt ˈaʊt/",
      "translation": "belirtmek, dikkat çekmek",
      "example": {
        "en": "She pointed out a mistake in my code.",
        "tr": "Kodumdaki bir hatayı belirtti."
      },
      "collocations": ["point out + a mistake", "point out + that ..."]
    },
    {
      "kind": "vocab",
      "id": "phv-come-up-with",
      "level": "B1",
      "term": "come up with",
      "ipa": "/ˌkʌm ʌp ˈwɪð/",
      "translation": "bulmak, ortaya atmak (fikir)",
      "example": {
        "en": "He came up with a simple solution.",
        "tr": "Basit bir çözüm buldu."
      },
      "collocations": ["come up with + an idea", "come up with + a solution"]
    },
    {
      "kind": "vocab",
      "id": "phv-take-over",
      "level": "B1",
      "term": "take over",
      "ipa": "/ˌteɪk ˈəʊvə/",
      "translation": "devralmak",
      "example": {
        "en": "Can you take over this task tomorrow?",
        "tr": "Bu görevi yarın devralabilir misin?"
      },
      "collocations": ["take over + a task", "take over + a project"]
    },
    {
      "kind": "vocab",
      "id": "phv-give-up",
      "level": "A2",
      "term": "give up",
      "ipa": "/ˌɡɪv ˈʌp/",
      "translation": "vazgeçmek, pes etmek",
      "example": {
        "en": "Do not give up after the first error.",
        "tr": "İlk hatadan sonra pes etme."
      },
      "collocations": ["give up + on something", "never give up"]
    }
  ],
  "quiz": [
    {
      "kind": "quiz",
      "id": "phv-q-set-up",
      "level": "A2",
      "format": "cloze",
      "prompt": "I will ___ the new laptop this evening.",
      "answer": "set up",
      "explanation": "`set up` = kurmak. Nesne (the new laptop) fiilden sonra ya da arasında gelebilir: set it up."
    },
    {
      "kind": "quiz",
      "id": "phv-q-figure-out",
      "level": "A2",
      "format": "multiple-choice",
      "prompt": "We finally ___ what caused the error.",
      "answer": "figured out",
      "options": ["figured out", "looked into", "gave up", "took over"],
      "explanation": "`figure out` bir sonuca ulaşmayı anlatır. `look into` ise henüz araştırma aşamasıdır."
    },
    {
      "kind": "quiz",
      "id": "phv-q-depend-on",
      "level": "A2",
      "format": "cloze",
      "prompt": "The result depends ___ your internet speed.",
      "answer": "on",
      "explanation": "`depend` her zaman `on` edatını alır: depend + on."
    },
    {
      "kind": "quiz",
      "id": "phv-q-look-into",
      "level": "A2",
      "format": "multiple-choice",
      "prompt": "The support team will ___ your complaint.",
      "answer": "look into",
      "options": ["look into", "look after", "look for", "look up"],
      "explanation": "`look into` = araştırmak. `look for` aramak, `look after` bakmak, `look up` sözlükten bakmaktır."
    },
    {
      "kind": "quiz",
      "id": "phv-q-run-into",
      "level": "A2",
      "format": "cloze",
      "prompt": "I ___ an old friend at the conference.",
      "answer": "ran into",
      "explanation": "`run into` beklenmedik karşılaşmayı anlatır. Geçmiş zamanda `run` düzensizdir: run → ran."
    },
    {
      "kind": "quiz",
      "id": "phv-q-back-up",
      "level": "A2",
      "format": "cloze",
      "prompt": "Always ___ your data before an update.",
      "answer": "back up",
      "explanation": "Fiil olarak iki kelime yazılır: back up. Tek kelime `backup` ise isimdir: make a backup."
    },
    {
      "kind": "quiz",
      "id": "phv-q-shut-down",
      "level": "A1",
      "format": "multiple-choice",
      "prompt": "Please ___ the machine when you finish.",
      "answer": "shut down",
      "options": ["shut down", "log in", "set up", "point out"],
      "explanation": "`shut down` bir cihazı kapatmaktır; `turn off` ile yakın anlamlıdır."
    },
    {
      "kind": "quiz",
      "id": "phv-q-log-in",
      "level": "A1",
      "format": "cloze",
      "prompt": "You have to log ___ before you can write a comment.",
      "answer": "in",
      "explanation": "`log in` giriş yapmaktır. Hedef sistem söyleniyorsa `to` eklenir: log in to the app."
    },
    {
      "kind": "quiz",
      "id": "phv-q-carry-out",
      "level": "B1",
      "format": "multiple-choice",
      "prompt": "Scientists ___ many experiments before the release.",
      "answer": "carried out",
      "options": ["carried out", "came up with", "broke down", "backed up"],
      "explanation": "`carry out` planlı bir işi yürütmektir: carry out a test / research / a plan."
    },
    {
      "kind": "quiz",
      "id": "phv-q-break-down",
      "level": "B1",
      "format": "cloze",
      "prompt": "Let's ___ the problem into three smaller parts.",
      "answer": "break down",
      "explanation": "`break down` burada parçalara ayırmak anlamındadır. Aynı öbek makineler için 'bozulmak' da demektir."
    },
    {
      "kind": "quiz",
      "id": "phv-q-roll-out",
      "level": "B1",
      "format": "multiple-choice",
      "prompt": "The company will ___ the update to all users in May.",
      "answer": "roll out",
      "options": ["roll out", "run into", "give up", "log in"],
      "explanation": "`roll out` yeni bir ürünü ya da özelliği kademeli olarak yayına almaktır."
    },
    {
      "kind": "quiz",
      "id": "phv-q-point-out",
      "level": "B1",
      "format": "cloze",
      "prompt": "She ___ that the report was missing a page.",
      "answer": "pointed out",
      "explanation": "`point out` bir şeye dikkat çekmektir ve sıklıkla `that` ile devam eder."
    },
    {
      "kind": "quiz",
      "id": "phv-q-come-up-with",
      "level": "B1",
      "format": "multiple-choice",
      "prompt": "It took him two days to ___ a good name for the app.",
      "answer": "come up with",
      "options": ["come up with", "carry out", "take over", "back up"],
      "explanation": "`come up with` bir fikir üretmektir ve üç kelimesi birlikte kullanılır; `with` düşmez."
    },
    {
      "kind": "quiz",
      "id": "phv-q-take-over",
      "level": "B1",
      "format": "cloze",
      "prompt": "When the manager left, Ayşe ___ the team.",
      "answer": "took over",
      "explanation": "`take over` sorumluluğu devralmaktır. Geçmiş zaman: take → took."
    },
    {
      "kind": "quiz",
      "id": "phv-q-give-up",
      "level": "A2",
      "format": "multiple-choice",
      "prompt": "The exercise was hard, but she did not ___.",
      "answer": "give up",
      "options": ["give up", "set up", "look into", "roll out"],
      "explanation": "`give up` pes etmektir. Bir şeyden vazgeçmek anlatılırken `on` gelir: give up on the idea."
    }
  ]
}
